{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "suppressImplicitAnyIndexErrors": true,
    "types": [
      "@types/node",
      "@pinia/nuxt",
      "@nuxtjs/tailwindcss",
      "types/masonry",
      "@nuxt/types",
      "@nuxt/vue-app",
      "@vue/runtime-core"
    ]
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": ["node_modules"]
}
