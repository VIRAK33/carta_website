<script lang="ts" setup>
/* IMPORTS */
import type { INews, NewsData } from '~/types/INews'
import { isEmpty } from 'lodash-es'
import { usePathImageUrl } from '~/@core/composables/useFile'
import { useRoute } from 'vue-router'

/* STATES */
const $route = useRoute()
const slug = computed(() => $route.params.slug as string)

// Fetch news detail independently through the worker proxy
const { data: newsResponse, pending, error } = await useFetch(
  () => `/api/news/${slug.value}`,
  {
    baseURL: "https://cms-proxy.seamvirak55.workers.dev",
    watch: [() => slug.value],
  }
)

// Extract the news data from response
const news = computed(() => {
  if (newsResponse.value?.success && newsResponse.value?.data) {
    const newsItem = newsResponse.value.data
    return {
      ...newsItem.data,
      createdAt: newsItem.createdAt,
      updatedAt: newsItem.updatedAt,
      id: newsItem.id,
    }
  }
  return null
})

// SEO Head
useHead(() => ({
  title: news.value ? `${news.value.title} | CARTA Blog` : 'CARTA Blog - News',
  meta: [
    {
      name: 'description',
      content: news.value?.short_content || 'Read the latest insights and updates from CARTA - Cambodia AI Robotics and Technology Transfer Association',
    },
    {
      name: 'og:title',
      property: 'og:title',
      content: news.value?.title || 'CARTA Blog',
    },
    {
      name: 'og:description',
      property: 'og:description',
      content: news.value?.short_content || 'Read the latest insights and updates from CARTA',
    },
    {
      name: 'og:image',
      property: 'og:image',
      content: news.value ? usePathImageUrl(news.value.thumbnail) : 'https://carta.org.kh/og-image.png',
    },
    {
      name: 'og:url',
      property: 'og:url',
      content: news.value ? `https://carta.org.kh/news/${news.value.slug}` : 'https://carta.org.kh/news',
    },
    {
      name: 'og:type',
      property: 'og:type',
      content: 'article',
    },
    {
      name: 'article:published_time',
      property: 'article:published_time',
      content: news.value?.createdAt || '',
    },
    {
      name: 'article:modified_time',
      property: 'article:modified_time',
      content: news.value?.updatedAt || '',
    },
    {
      name: 'twitter:card',
      content: 'summary_large_image',
    },
    {
      name: 'twitter:title',
      content: news.value?.title || 'CARTA Blog',
    },
    {
      name: 'twitter:description',
      content: news.value?.short_content || 'Read the latest insights and updates from CARTA',
    },
    {
      name: 'twitter:image',
      content: news.value ? usePathImageUrl(news.value.thumbnail) : 'https://carta.org.kh/og-image.png',
    },
  ],
  link: [
    {
      rel: 'canonical',
      href: news.value ? `https://carta.org.kh/news/${news.value.slug}` : 'https://carta.org.kh/news',
    },
  ],
}))
</script>

<template>
  <div v-if="!isEmpty(news)" class="fixed-width py-14 p-6 max-w-4xl mx-auto">
    <!-- Hero Image -->
    <div class="w-full rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800 mb-8">
      <div class="relative w-full pt-[56.25%]">
        <img
          :src="usePathImageUrl(news.thumbnail)"
          alt=""
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
          @error="e => e.target.src = '/placeholder.png'"
        />
      </div>
    </div>

    <!-- Header Section -->
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl lg:text-5xl text-gray-800 dark:text-gray-100 font-bold mb-4">
        {{ news.title }}
      </h1>
      <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
        <span class="inline-block px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded-full">
          {{ $moment(news.createdAt).format('MMM DD, YYYY') }}
        </span>
        <span v-if="news.updatedAt && news.updatedAt !== news.createdAt" class="text-xs">
          Updated: {{ $moment(news.updatedAt).format('MMM DD, YYYY') }}
        </span>
      </div>
    </div>

    <!-- Short Content / Excerpt -->
    <div v-if="news.short_content" class="mb-8 p-4 bg-gray-50 dark:bg-gray-800 rounded-lg border-l-4 border-blue-500">
      <p class="text-lg text-gray-700 dark:text-gray-300 italic">
        {{ news.short_content }}
      </p>
    </div>

    <!-- Main Content -->
    <div class="mb-8 prose dark:prose-invert max-w-none">
      <div class="text-gray-700 dark:text-gray-300 leading-relaxed" v-html="news.content" />
    </div>

    <!-- Gallery -->
    <div v-if="news.gallery && news.gallery.length > 0" class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4">Gallery</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div
          v-for="(image, index) in news.gallery"
          :key="index"
          class="rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-800"
        >
          <div class="relative w-full pt-[75%] overflow-hidden group cursor-pointer">
            <img
              :src="usePathImageUrl(image)"
              :alt="`Gallery image ${index + 1}`"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
              loading="lazy"
              @error="e => e.target.src = '/placeholder.png'"
            />
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-20 transition-opacity duration-300" />
          </div>
        </div>
      </div>
    </div>

    <!-- Metadata -->
    <div class="mt-12 pt-6 border-t border-gray-200 dark:border-gray-700">
      <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 dark:text-gray-400">
        <div>
          <span class="font-semibold">ID:</span> {{ news.id }}
        </div>
        <div>
          <span class="font-semibold">Slug:</span> {{ news.slug }}
        </div>
        <div>
          <span class="font-semibold">Created:</span> {{ $moment(news.createdAt).format('YYYY-MM-DD HH:mm') }}
        </div>
        <div v-if="news.updatedAt">
          <span class="font-semibold">Updated:</span> {{ $moment(news.updatedAt).format('YYYY-MM-DD HH:mm') }}
        </div>
      </div>
    </div>
  </div>

  <!-- No data state -->
  <div v-else class="fixed-width py-14 text-center">
    <div v-if="pending" class="text-gray-500 dark:text-gray-400">
      <div class="inline-block">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500 mx-auto mb-4"></div>
        <p>Loading article...</p>
      </div>
    </div>
    <div v-else-if="error" class="text-red-500">
      <p class="font-semibold mb-2">Failed to load article</p>
      <p class="text-sm">{{ error.message || 'An error occurred while fetching the article' }}</p>
    </div>
    <div v-else class="text-gray-500 dark:text-gray-400">
      <p>No article found</p>
    </div>
  </div>
</template>

